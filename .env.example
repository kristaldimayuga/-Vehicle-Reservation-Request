# Copy to .env and fill in real values. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=govfleet
DB_USER=govfleet_app
DB_PASSWORD=change-me
# Use 127.0.0.1, not localhost (avoids a slow IPv6 attempt on Windows).
DB_HOST=127.0.0.1
DB_PORT=5432
# Seconds to wait for PostgreSQL before giving up (optional, default 5).
DB_CONNECT_TIMEOUT=5

# Max reservation requests per user (optional, default 30/hour).
THROTTLE_RESERVATION_CREATE=30/hour
# Max sign-in attempts per client (optional, default 20/min).
THROTTLE_AUTH_SESSION=20/min

# --- Firebase ---
# Service-account key: a SECRET. Keep the JSON file OUTSIDE this repository
# and put only its absolute path here.
FIREBASE_CREDENTIALS=C:\path\outside\repo\your-project-firebase-adminsdk.json
FIREBASE_PROJECT_ID=your-project-id
# Web app config (Project settings > General > Your apps). Public by design.
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
