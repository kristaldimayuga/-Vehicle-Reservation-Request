# Copy to .env and fill in real values. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=govfleet
DB_USER=govfleet_app
DB_PASSWORD=change-me
# Use 127.0.0.1, not localhost (avoids a slow IPv6 attempt on Windows).
DB_HOST=127.0.0.1
DB_PORT=5432
# Seconds to wait for PostgreSQL before giving up (optional, default 5).
DB_CONNECT_TIMEOUT=5

# Max reservation requests per user (optional, default 30/hour).
THROTTLE_RESERVATION_CREATE=30/hour
